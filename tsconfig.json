{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@ui/*": ["ui/*"] }
  },
  "include": [
    "pages",
    "server",
    "ui",
    "api",
    "state",
    "lib",
    "vitest.setup.ts",
    "vitest.config.ts",
    "playwright.ct-config.ts",
    ".storybook",
    "e2e"
  ],
  "exclude": ["**/*.stories.ts", "**/*.stories.tsx"]
}

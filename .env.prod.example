# Backoffice production env — TEMPLATE.
# Copy to backoffice/.env.prod (same directory) and fill REAL values.
# backoffice/.env.prod is untracked: NEVER commit real secrets.

NODE_ENV=production
PORT=3011
BACKEND_ORIGIN=http://127.0.0.1:8080

# Origins allowed to use the menu preview endpoints (comma separated).
PREVIEW_WEB_ORIGINS=https://backoffice.alqueriavillacarmen.com,https://alqueriavillacarmen.com

# Shared secret added server-side to proxied /api/admin calls (REST + WS).
# Must match the backend VAULT_KEY. Never expose it to the browser bundle.
VAULT_KEY=

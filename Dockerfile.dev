FROM oven/bun:1.3.14
WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY . .

# Install Playwright + Chromium so `bun run test:browser` can exercise the
# menu-preview iframe regression suite. The base bun image ships without
# these system libs; `bunx playwright install --with-deps chromium` adds
# everything required for headless Chromium.
RUN bunx playwright install --with-deps chromium || true

ENV NODE_ENV=development
ENV PORT=3010
EXPOSE 3010

CMD ["bun", "--env-file", ".env.local", "server/index.ts"]

{
  "name": "villacarmen-backoffice",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "bun --env-file .env.local server/index.ts",
    "dev:watch": "bun --env-file .env.local --watch server/index.ts",
    "dev:local": "bash ./scripts/dev-local.sh",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-jsx-data-attr.js pages ui",
    "lint:jsx": "node scripts/check-jsx-data-attr.js pages ui",
    "lint:jsx:strict": "node scripts/check-jsx-data-attr.js pages ui components",
    "lint:es": "eslint pages ui --ext .tsx,.ts",
    "lint:all": "tsc -p tsconfig.json --noEmit && node scripts/check-jsx-data-attr.js pages ui components && eslint pages ui --ext .tsx,.ts",
    "lint:data-testid": "node scripts/check-data-testid.js pages/login pages/app/comida ui",
    "lint:data-testid:all": "node scripts/check-data-testid.js pages ui",
    "lint:data-testid:fix": "echo 'Run agent-browser to add data-testid to components'",
    "build": "NODE_ENV=production vike build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "node scripts/regression.js",
    "test:regression:full": "node scripts/regression.js --full",
    "test:regression:smoke": "node scripts/regression.js --smoke-only",
    "test:regression:ci": "node scripts/regression.js --ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:new": "node scripts/e2e-new.mjs",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:forky-tools": "FORKY_REAL_TOOLS_E2E=1 playwright test e2e/specs/forky/forky-tools-*.spec.ts --project=chromium-1280 --headed --workers=1",
    "test:e2e:responsive": "playwright test --grep @responsive",
    "test:e2e:crud": "playwright test e2e/specs/comida/",
    "test:e2e:signalr": "playwright test e2e/specs/comida/signalr.spec.ts",
    "test:ct": "vitest run",
    "test:ct:ui": "vitest",
    "test:ct:pw": "npx playwright test -c playwright.ct-config.ts --headed",
    "test:ct:pw:ci": "npx playwright test -c playwright.ct-config.ts",
    "test:storybook": "npx playwright test e2e/specs/storybook-integration.spec.ts",
    "test:storybook:ui": "npx playwright test e2e/specs/storybook-integration.spec.ts --ui",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.4",
    "@assistant-ui/react-markdown": "^0.14.8",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@headlessui/react": "^2.2.9",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@testing-library/dom": "^10.0.0",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "glimm": "0.3.0",
    "gsap": "^3.13.2",
    "jotai": "^2.14.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.26",
    "liveline": "0.0.7",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.12",
    "patchright": "^1.61.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-country-flag": "^3.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^3.4.17",
    "thinking-orbs": "0.2.0",
    "three": "^0.185.1",
    "vike": "^0.4.252",
    "vike-react": "^0.6.19",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^10.3.5",
    "@storybook/test": "8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^5.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-is": "^18.3.1",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "storybook": "^10.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
